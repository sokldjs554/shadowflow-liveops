SHADOWFLOW_STATE_DIR=.shadowflow
SHADOWFLOW_PROVIDER=deterministic-demo

# OpenAI-compatible local/open model endpoint (Ollama/vLLM/Qwen etc.)
SHADOWFLOW_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
SHADOWFLOW_OPENAI_MODEL=qwen2.5-coder:7b
SHADOWFLOW_OPENAI_API_KEY=ollama
SHADOWFLOW_LLM_TIMEOUT_SECONDS=60

# Optional hosted Messages API route
ANTHROPIC_API_KEY=
SHADOWFLOW_ANTHROPIC_MODEL=claude-sonnet-4-5
