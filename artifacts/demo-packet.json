    "content": "import { test, expect } from '@playwright/test';\n\nasync function requireHumanApproval(action: string): Promise<void> {\n  const token = process.env.SHADOWFLOW_APPROVAL_TOKEN;\n  if (!token) throw new Error(`Human approval required before: ${action}`);\n}\n\ntest('compiled live-ops workflow', async ({ page }) => {\n  // step-01: Open page\n  await page.goto(\"/synthetic-liveops/events/new\");\n  // step-02: Set Event name\n  await page.getByRole(\"textbox\", { name: \"Event name\" }).fill(\"Autumn Table Week\");\n  // step-03: Choose Regions\n  await page.getByRole(\"listbox\", { name: \"Regions\" }).selectOption([\"KR\", \"JP\", \"US\"]);\n  // step-04: Set Korean announcement\n  await page.getByRole(\"textbox\", { name: \"Korean announcement\" }).fill(\"가을 이벤트가 시작됩니다.\");\n  // step-05: Set Japanese announcement\n  await page.getByRole(\"textbox\", { name: \"Japanese announcement\" }).fill(\"秋のイベントが始まります。\");\n  // step-06: Set English announcement\n  await page.getByRole(\"textbox\", { name: \"English announcement\" }).fill(\"Autumn event is live.\");\n  // step-07: Set Start time UTC\n  await page.getByRole(\"textbox\", { name: \"Start time UTC\" }).fill(\"2026-10-01T00:00:00Z\");\n  // step-08: Set End time UTC\n  await page.getByRole(\"textbox\", { name: \"End time UTC\" }).fill(\"2026-10-08T00:00:00Z\");\n  // step-09: Attach Choose banner\n  await page.getByLabel(\"Banner asset\").setInputFiles(\"fixtures/autumn-banner.webp\");\n  // step-10: Preview Preview event\n  await page.getByRole(\"button\", { name: \"Preview event\" }).click();\n  await expect(page.getByText('Preview ready')).toBeVisible();\n  // step-11: Publish Publish event\n  await requireHumanApproval(\"Publish Publish event\");\n  await page.getByRole(\"button\", { name: \"Publish event\" }).click();\n});\n",
